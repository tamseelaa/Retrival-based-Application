# Local LLM (Ollama) Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embedding Model Configuration
# Default: local Ollama (no API key required)
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Optional: override the embedding base URL (defaults to OLLAMA_BASE_URL)
# EMBED_BASE_URL=http://localhost:11434

# Optional: use OpenAI embeddings instead of Ollama
# OPENAI_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-large
# EMBED_DIM=3072

# PostgreSQL + pgvector Configuration
# For local Docker (default — works out of the box with docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# Alternative: individual connection parameters (used if DATABASE_URL is not set)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=rag_db

# For AWS RDS / Aurora PostgreSQL:
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>

# Inngest Workflow Configuration
# Local dev server API base (used by streamlit_app.py to poll run output)
INNGEST_API_BASE=http://127.0.0.1:8288/v1
